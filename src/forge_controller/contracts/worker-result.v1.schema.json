{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_order_id",
    "outcome",
    "summary",
    "evidence",
    "changes",
    "uncertainties",
    "checks_not_run"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "work_order_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "outcome": {
      "enum": [
        "proposal",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "start_line",
          "end_line",
          "claim"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_/-]+\\.(py|md|toml)$",
            "maxLength": 256
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        }
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "old",
          "new"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)[A-Za-z0-9_/-]+\\.(py|md|toml)$",
            "maxLength": 256
          },
          "old": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          },
          "new": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000
          }
        }
      },
      "minItems": 0,
      "maxItems": 4,
      "uniqueItems": true
    },
    "uncertainties": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    },
    "checks_not_run": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted worker result v1"
}
